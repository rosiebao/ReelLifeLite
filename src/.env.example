# Local settings for `npm start`. Copy to .env (git-ignored) and fill in.
# Anything already set in your shell wins over this file.

# Have Claude run the interview and write the story on "End". Anything else
# (or unset) uses canned questions, and "End" just joins your answers.
INTERVIEW_AI=bedrock

# Bedrock region for the interviewer. Takes priority over AWS_REGION, which
# your shell may set for something else. Not every region serves every model:
# a 404 "model does not exist" usually means try another region.
INTERVIEW_AWS_REGION=us-east-1

# Bedrock model ID (optional).
# INTERVIEW_MODEL=anthropic.claude-opus-5

# Credentials: one of these, unless your shell or ~/.aws already has them.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
